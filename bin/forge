#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

SHIPYARD_HOME="${SHIPYARD_HOME:-$HOME/.config/shipyard}"

# shellcheck source=../lib/context.sh
source "$SHIPYARD_HOME/lib/context.sh"

# shellcheck source=../lib/hooks.sh
source "$SHIPYARD_HOME/lib/hooks.sh"

# shellcheck source=../lib/pipeline.sh
source "$SHIPYARD_HOME/lib/pipeline.sh"

# shellcheck source=../lib/session.sh
source "$SHIPYARD_HOME/lib/session.sh"

# shellcheck source=../lib/watcher.sh
source "$SHIPYARD_HOME/lib/watcher.sh"

# shellcheck source=../lib/screenshot.sh
source "$SHIPYARD_HOME/lib/screenshot.sh"

forge_usage() {
    cat <<'EOF'
Shipyard coordinates AI-powered software development workflows.

Usage:
  forge               Attach to a pre-existing shipyard tmux window, if one
                       is open; otherwise print a message and do nothing
  forge open [path]   Open (or create) a project's tmux session, Yazi repo
                       window, and command window. With no path, instead
                       restores paused repository sessions and every leased
                       intent window after a pause or tmux server loss
  forge new <intent>[, <intent>...]
                       Create intent window(s) in leased Treehouse worktrees.
                       Commas split the input without quoting, for example:
                       forge new issue 1, issue 2, issue 3
  forge close         Force-close this window: abort any active no-mistakes
                       run for it, discard uncommitted changes, and return
                       the Treehouse lease. On a repo's command window,
                       closes every intent and the whole repository session.
                       The Yazi repo window is protected from forge close

  forge pause         Save the state of every open shipyard repo/intent
                       window and close all of them, without returning any
                       Treehouse lease. forge open restores everything

  forge publish-screenshot <file> [<file> ...]
                       Upload screenshot(s) to a rolling GitHub Release and
                       print PR-ready markdown image links

  forge build         Mark the pipeline as building
  forge alert         Mark the pipeline as needing attention
  forge status        Show the pipeline state

  forge help          Show this help
EOF
}

main() {
    local command="${1:-attach}"

    case "$command" in
        attach)
            shipyard_attach
            ;;

        open)
            shift
            if [[ $# -eq 0 ]]; then
                shipyard_restore
            else
                shipyard_open "$1"
            fi
            ;;

        new)
            shift
            shipyard_new "$@"
            ;;

        close)
            shipyard_close
            ;;

        pause)
            shipyard_pause
            ;;

        publish-screenshot)
            shift
            screenshot_publish "$@"
            ;;

        build)
            pipeline_set building
            ;;

        alert)
            pipeline_set attention
            ;;

        status)
            pipeline_status
            ;;

        watch)
            shift
            watcher_run "$@"
            ;;

        reap)
            shift
            shipyard_reap "$@"
            ;;

        reconcile)
            shipyard_reconcile
            ;;

        help|-h|--help)
            forge_usage
            ;;

        *)
            printf 'forge: unknown command: %s\n\n' "$command" >&2
            forge_usage >&2
            return 2
            ;;
    esac
}

main "$@"
