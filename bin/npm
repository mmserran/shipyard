#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

SHIPYARD_HOME="${SHIPYARD_HOME:-$HOME/.config/shipyard}"

# Only meaningful once a worktree's node_modules has been symlinked to its
# root checkout's (see `forge new-deps` / `forge no-new-deps`): a real or
# absent node_modules means there's nothing shared to protect, so this is a
# no-op everywhere else, including non-Node repositories.
npm_guard_nearest_node_modules() {
    local dir="$PWD"

    while :; do
        if [[ -e "$dir/node_modules" ]]; then
            printf '%s\n' "$dir/node_modules"
            return 0
        fi
        [[ "$dir" == "/" ]] && return 1
        dir="$(dirname "$dir")"
    done
}

# Resolve the real npm binary, skipping this script's own directory on PATH
# so we don't recurse into ourselves.
npm_guard_real_npm() {
    local dir
    local IFS=:

    for dir in $PATH; do
        [[ "$dir" == "$SHIPYARD_HOME/bin" ]] && continue
        if [[ -x "$dir/npm" ]]; then
            printf '%s\n' "$dir/npm"
            return 0
        fi
    done
    return 1
}

main() {
    local real_npm
    local node_modules

    if ! real_npm="$(npm_guard_real_npm)"; then
        printf 'forge: npm: no real npm found on PATH\n' >&2
        exit 1
    fi

    if node_modules="$(npm_guard_nearest_node_modules)" && [[ -L "$node_modules" ]]; then
        case "${1:-}" in
            install|i|ci|add|update|up|remove|rm|uninstall|un|dedupe|prune)
                printf 'npm %s is disabled in this worktree: node_modules is symlinked to the root checkout.\n' \
                    "$1" >&2
                printf "Run it in the root checkout instead, or 'forge new-deps' first if this branch changes dependencies.\n" >&2
                exit 1
                ;;
        esac
    fi

    exec "$real_npm" "$@"
}

main "$@"
