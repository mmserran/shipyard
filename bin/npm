#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

SHIPYARD_HOME="${SHIPYARD_HOME:-$HOME/.config/shipyard}"

# Only meaningful once a worktree's node_modules has been symlinked to its
# root checkout's (see `forge new-deps` / `forge no-new-deps`): a real or
# absent node_modules means there's nothing shared to protect, so this is a
# no-op everywhere else, including non-Node repositories.
npm_guard_nearest_node_modules() {
    local dir="${1:-$PWD}"

    [[ "$dir" == /* ]] || dir="$PWD/$dir"

    while :; do
        if [[ -e "$dir/node_modules" || -L "$dir/node_modules" ]]; then
            printf '%s\n' "$dir/node_modules"
            return 0
        fi
        [[ "$dir" == "/" ]] && return 1
        dir="$(dirname "$dir")"
    done
}

# Resolve the real npm binary, skipping this script's own directory on PATH
# so we don't recurse into ourselves.
npm_guard_real_npm() {
    local dir
    local IFS=:

    for dir in $PATH; do
        [[ "$dir" == "$SHIPYARD_HOME/bin" ]] && continue
        if [[ -x "$dir/npm" ]]; then
            printf '%s\n' "$dir/npm"
            return 0
        fi
    done
    return 1
}

# Finds the npm subcommand among global options. npm's config flags are too
# numerous to enumerate exhaustively, so an option this doesn't recognize as
# either value-taking or a known boolean makes the parse untrustworthy: it
# fails closed (prints nothing, exit 1) rather than risk misreading a flag's
# value as the subcommand and letting a mutating command slip through.
npm_guard_command() {
    local arg
    local skip_value=0
    local found=""

    for arg in "$@"; do
        if [[ "$skip_value" -eq 1 ]]; then
            skip_value=0
            continue
        fi

        case "$arg" in
            --)
                continue
                ;;
            --prefix|--cache|--userconfig|--globalconfig|--registry|--scope| \
            --workspace|--loglevel|--otp|--tag|--dist-tag|--access|--before| \
            --after|--package)
                skip_value=1
                ;;
            -C|-w)
                skip_value=1
                ;;
            --force|--global|-g|--save|-S|--save-dev|-D|--save-exact|-E| \
            --save-optional|-O|--save-peer|--save-prod|-P|--legacy-peer-deps| \
            --ignore-scripts|--dry-run|--yes|-y|--json|--long|--offline| \
            --prefer-offline|--prefer-online|--fund|--no-fund|--audit| \
            --no-audit|--silent|--quiet)
                ;;
            --*=*)
                ;;
            -*)
                return 1
                ;;
            *)
                [[ -z "$found" ]] && found="$arg"
                ;;
        esac
    done

    [[ -n "$found" ]] || return 1
    printf '%s\n' "$found"
}

npm_guard_working_dir() {
    local arg
    local dir="$PWD"
    local expect_dir=0

    for arg in "$@"; do
        if [[ "$expect_dir" -eq 1 ]]; then
            dir="$arg"
            expect_dir=0
            continue
        fi

        case "$arg" in
            --)
                break
                ;;
            --prefix|-C)
                expect_dir=1
                ;;
            --prefix=*)
                dir="${arg#--prefix=}"
                ;;
        esac
    done

    printf '%s\n' "$dir"
}

main() {
    local command
    local guard_dir
    local real_npm
    local node_modules

    if ! real_npm="$(npm_guard_real_npm)"; then
        printf 'forge: npm: no real npm found on PATH\n' >&2
        exit 1
    fi

    command="$(npm_guard_command "$@")" || command=""
    guard_dir="$(npm_guard_working_dir "$@")"
    if node_modules="$(npm_guard_nearest_node_modules "$guard_dir")" && [[ -L "$node_modules" ]]; then
        case "$command" in
            install|i|ci|add|update|up|remove|rm|uninstall|un|dedupe|prune)
                printf 'npm %s is disabled in this worktree: node_modules is symlinked to the root checkout.\n' \
                    "$command" >&2
                printf "Run it in the root checkout instead, or 'forge new-deps' first if this branch changes dependencies.\n" >&2
                exit 1
                ;;
            "")
                printf 'npm: could not confirm this is safe against a symlinked node_modules (unrecognized option).\n' >&2
                printf "Run it in the root checkout instead, or 'forge new-deps' first if this branch changes dependencies.\n" >&2
                exit 1
                ;;
        esac
    fi

    exec "$real_npm" "$@"
}

main "$@"
